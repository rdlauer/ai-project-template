# Dashboard environment variables.
# Copy this file to dashboard/.env (or .env.local, depending on the framework) and fill in the values.
# Never commit the real file. Document every variable in dashboard/README.md.

# Notehub project UID, e.g. app:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTEHUB_PROJECT_UID=

# Notehub personal access token (user menu > API Access > Create New Token).
# Scope it to this project: "Viewer Privileges in One Project", or "My Privileges
# in One Project" if the dashboard changes things in Notehub.
# Server-side only. Never expose it to the browser.
NOTEHUB_PERSONAL_ACCESS_TOKEN=
